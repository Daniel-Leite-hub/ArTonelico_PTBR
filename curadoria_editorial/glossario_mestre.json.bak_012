      "pt": "Magia da Canção",
      "gender": "feminino",
      "number": "singular",
      "category": "Combate / Magia",
      "note": "Poder conjurado pelas Reyvateils. A canção cresce em potência enquanto elas cantam (Harmonics/Burst)."
    },
